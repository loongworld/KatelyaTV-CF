# KatelyaTV CF — Cloudflare Pages + D1 环境变量示例
# 构建期变量：在 CI 或本地 shell 中 export（NEXT_PUBLIC_* 会被内联进产物）
# 运行期变量：用 `wrangler pages secret put <KEY>` 写入（或 Dashboard → Settings → Environment variables）

# ==================== 构建期 ====================
# 存储后端（本仓库固定为 d1）
NEXT_PUBLIC_STORAGE_TYPE=d1

# 图片代理前缀（内置边缘代理，破解豆瓣防盗链）
NEXT_PUBLIC_IMAGE_PROXY=/api/image-proxy?url=

# 站点完整 URL（当前代码未读取，仅作记录）
NEXTAUTH_URL=https://your-project.pages.dev

# 是否开放注册（可选，后台配置优先）
# NEXT_PUBLIC_ENABLE_REGISTER=true

# ==================== 运行期（Secrets）====================
# ⚠️ 不要使用 PASSWORD 作为变量名——它是 Cloudflare 保留绑定名
USERNAME=admin
AUTH_PASSWORD=change_me_to_a_strong_password

# 会话签名密钥（≥32 位随机串）。缺失时退化为由 AUTH_PASSWORD 派生（不推荐）
SESSION_SECRET=

# /api/cron 的 Bearer 密钥；不配则该接口返回 503（默认禁用）
# CRON_SECRET=

# TVBox 订阅专用令牌（可选，≥16 字符）：配置后可与登录会话解耦、单独轮换
# TVBOX_TOKEN=

# ==================== 运行期（普通变量，可选）====================
# 站点名 / 公告回退值：仅在后台未设置站点配置时生效
# SITE_NAME=KatelyaTV
# ANNOUNCEMENT=

# ==================== 说明 ====================
# - D1 绑定（binding 名必须为 DB）在 wrangler.toml 的 [[d1_databases]] 中配置
# - 初始化数据库：wrangler d1 execute katelyatv-db --remote --file=./scripts/d1-init.sql
# - 已有库升级到 1.3.0：ALTER TABLE users ADD COLUMN session_version INTEGER NOT NULL DEFAULT 0;
