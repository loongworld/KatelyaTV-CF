# KatelyaTV-CF 环境变量示例（Cloudflare Pages + D1）
#
# 这里只列出代码真正会读取的变量。真实部署不读这个文件，
# 它只是给你复制到 Cloudflare Dashboard 时用的清单。
#
# 两条硬规则：
# 1. NEXT_PUBLIC_* 是构建期内联的，改完必须重新部署才生效；
# 2. 敏感值一律用 Dashboard 的 Secret（加密）类型，不要落进仓库。

# ===== 构建期（NEXT_PUBLIC_*，写在 Dashboard 的 Variables 里）=====

# 存储后端，本仓库固定 d1
NEXT_PUBLIC_STORAGE_TYPE=d1

# 图片代理前缀（内置边缘代理，破解豆瓣防盗链）
NEXT_PUBLIC_IMAGE_PROXY=/api/image-proxy?url=

# 搜索最大翻页数（可选，默认 5）
# NEXT_PUBLIC_SEARCH_MAX_PAGE=5

# 豆瓣数据代理前缀（可选，留空则走内置 /api/douban）
# NEXT_PUBLIC_DOUBAN_PROXY=

# 是否开放注册（可选，后台 UserConfig.AllowRegister 优先）
# NEXT_PUBLIC_ENABLE_REGISTER=false

# 登录页版本按钮跳转的仓库地址（可选，默认本仓库）
# NEXT_PUBLIC_REPO_URL=https://github.com/wooxi/KatelyaTV-CF

# 版本检查地址（可选；不配置则不发起任何外部请求）
# NEXT_PUBLIC_VERSION_URL_PRIMARY=
# NEXT_PUBLIC_VERSION_URL_BACKUP=

# ===== 运行期（Dashboard 的 Secrets）=====

# 站长用户名
USERNAME=admin

# 站长密码
AUTH_PASSWORD=change_me_to_a_strong_password

# 会话签名密钥，≥32 位随机串。
# 不配也能跑，但会退化成用 AUTH_PASSWORD 直接派生（无 KDF，会话 Cookie 泄漏即可离线爆破）。
# 生成：openssl rand -base64 48
SESSION_SECRET=

# /api/cron 的 Bearer 密钥；不配则该接口直接返回 503（默认禁用）
# CRON_SECRET=

# TVBox 订阅专用令牌（可选，≥16 字符）。
# 配置后 /api/tvbox 使用该固定令牌，可与登录会话解耦：想吊销订阅时只换这个值，
# 不影响任何人的登录状态；不配置则由会话密钥派生（轮换密钥会连带失效）。
# TVBOX_TOKEN=

# ===== 运行期（普通变量，可选）=====

# 站点名 / 公告回退值：仅在后台（/admin）未设置站点配置时生效
# SITE_NAME=KatelyaTV
# ANNOUNCEMENT=

# ===== 部署提示 =====
# - D1 绑定名必须是 DB，在 wrangler.toml 的 [[d1_databases]] 配置
# - ⚠️ 不要用 PASSWORD 作为变量名，它是 Cloudflare 的保留绑定名
# - 初始化数据库：wrangler d1 execute katelyatv-db --remote --file=./scripts/d1-init.sql
# - 已有库升级到 1.3.0（会话吊销）：ALTER TABLE users ADD COLUMN session_version INTEGER NOT NULL DEFAULT 0;
# - 搜索一次请求最多检索有限数量的源（免费版单请求子请求上限 50），
#   源更多时前端会自动分片补齐，无需配置
